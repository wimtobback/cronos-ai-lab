---
// src/components/ProcessSteps.astro
// Numbered steps on a top-ruled column grid. Every Request for AI page shows
// its own process; the homepage shows the Challenges one as the 90-day path.
interface Props {
  steps: { title: string; body: string }[];
  class?: string;
}
const { steps, class: className } = Astro.props;
---

<ol class:list={['grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4', className]}>
  {
    steps.map((step, i) => (
      <li class="border-t border-ink pt-5">
        <p class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.12em] text-accent-ink">
          Step {String(i + 1).padStart(2, '0')}
        </p>
        <h3 class="mt-3 text-h3">{step.title}</h3>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
          {step.body}
        </p>
      </li>
    ))
  }
</ol>
