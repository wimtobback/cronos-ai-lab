---
interface Props {
  class?: string;
  /** Render the wordmark for inverted (dark) surfaces. */
  invert?: boolean;
}
const { class: className, invert = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    width="22"
    height="22"
    viewBox="0 0 22 22"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <!-- Three linked nodes: the lab's graph motif. -->
    <path
      d="M11 3.6 4.2 17.2h13.6L11 3.6Z"
      stroke={invert ? '#FBFAF8' : '#0B0B0C'}
      stroke-width="1.4"
      stroke-linejoin="round"
    />
    <circle cx="11" cy="3.6" r="2.4" fill="var(--color-accent)" />
    <circle cx="4.2" cy="17.2" r="2.4" fill={invert ? '#FBFAF8' : '#0B0B0C'} />
    <circle cx="17.8" cy="17.2" r="2.4" fill={invert ? '#FBFAF8' : '#0B0B0C'} />
  </svg>
  <span class="text-[0.9375rem] font-semibold tracking-[-0.015em] whitespace-nowrap">
    Cronos <span class="font-normal opacity-60">AI Lab</span>
  </span>
</span>
