---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import RuledList from '../../components/RuledList.astro';
import RuledRow from '../../components/RuledRow.astro';
import CtaBand from '../../components/CtaBand.astro';

const all = (await getCollection('startups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title="Startups"
  description="The companies built out of Cronos AI Lab — from validated enterprise demand to funded venture."
>
  <section class="shell pt-20 pb-16 md:pt-28 md:pb-20">
    <Reveal class="max-w-3xl">
      <p class="eyebrow">Portfolio &middot; {all.length} companies</p>
      <h1 class="mt-6 text-h1">The companies coming out of the Lab.</h1>
      <p class="mt-7 text-lead text-muted">
        Every one of these started as a problem someone was already paying to
        work around. We find the demand first and the founder second.
      </p>
    </Reveal>
  </section>

  <section class="shell pb-section" aria-labelledby="companies-list">
    <h2 id="companies-list" class="sr-only">All companies</h2>
    <Reveal>
      <RuledList>
        {
          all.map((startup) => (
            <RuledRow
              logo={startup.data.logo}
              title={startup.data.name}
              summary={startup.data.tagline}
              meta={`${startup.data.stage} · ${startup.data.cohort}`}
              href={`/startups/${startup.id}`}
            />
          ))
        }
      </RuledList>
    </Reveal>
  </section>

  <CtaBand eyebrow="Building something already?" href="/request-for-ai/startups" label="Request for AI Startups">
    We bring enterprise distribution, engineering depth and capital.
  </CtaBand>
</BaseLayout>
