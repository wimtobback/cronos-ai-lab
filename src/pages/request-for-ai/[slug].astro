---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import RequestForm from '../../components/RequestForm.astro';
import Figure from '../../components/Figure.astro';
import RuledList from '../../components/RuledList.astro';
import RuledRow from '../../components/RuledRow.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const requests = (await getCollection('requests')).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return requests.map((request, index) => ({
    params: { slug: request.id },
    props: {
      request,
      // Every page links on to the next offering, so no page is a dead end.
      next: requests[(index + 1) % requests.length],
    },
  }));
}

const { request, next } = Astro.props;
const d = request.data;
const { Content } = await render(request);
---

<BaseLayout title={d.title} description={d.summary}>
  <!-- ===== Header ======================================================== -->
  <section class="shell pt-20 pb-16 md:pt-28 md:pb-24">
    <Reveal class="max-w-4xl">
      <div class="flex items-center gap-4">
        <span
          class="flex size-12 shrink-0 items-center justify-center rounded-full bg-ink text-paper"
        >
          <Icon name={d.icon} class="size-5" aria-hidden="true" />
        </span>
        <p class="eyebrow">{d.eyebrow}</p>
      </div>

      <h1 class="mt-8 text-h1">{d.heroHeadline}</h1>
      <p class="mt-7 max-w-2xl text-lead text-muted">{d.heroLead}</p>

      <div class="mt-9">
        <a href="#apply" class="btn btn-primary">{d.formTitle}</a>
      </div>
    </Reveal>
  </section>

  {d.image ? (
    <section class="shell">
      <Figure src={d.image} alt={d.imageAlt} />
    </section>
  ) : (
    <div class="shell"><hr class="border-rule" /></div>
  )}

  <!-- ===== Who it is for ================================================= -->
  <section class="shell py-section" aria-labelledby="for-who">
    <Reveal class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="eyebrow">Fit</p>
        <h2 id="for-who" class="mt-4 text-h2">Who this is for</h2>
      </div>

      <div class="lg:col-span-8">
        <ul class="divide-y divide-rule border-y border-rule">
          {
            d.forWho.map((item) => (
              <li class="flex gap-4 py-5 text-lead leading-snug">
                <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </Reveal>
  </section>

  <!-- ===== What you get ================================================== -->
  {/* The page's one ink band, between paper on both sides. Full-bleed, the
      same shape as the homepage's Request for AI section. */}
  <section class="on-ink" aria-labelledby="you-get">
    <div class="shell py-section">
      <Reveal>
        <p class="eyebrow">What you get</p>
        <h2 id="you-get" class="mt-4 max-w-2xl text-h2">
          What the Lab actually brings.
        </h2>

        <RuledList class="mt-12">
          {
            d.youGet.map((item, i) => (
              <RuledRow
                index={String(i + 1).padStart(2, '0')}
                title={item.title}
                summary={item.body}
              />
            ))
          }
        </RuledList>
      </Reveal>
    </div>
  </section>

  <!-- ===== Process ======================================================= -->
  <section class="shell py-section" aria-labelledby="process">
    <Reveal>
      <p class="eyebrow">Process</p>
      <h2 id="process" class="mt-4 max-w-2xl text-h2">How it works.</h2>

      <ProcessSteps steps={d.process} class="mt-12" />
    </Reveal>
  </section>

  {/* Optional long-form body from the markdown file, if any was written. */}
  {
    request.body?.trim() && (
      <section class="shell pb-section">
        <Reveal class="prose">
          <Content />
        </Reveal>
      </section>
    )
  }

  <!-- ===== Form ========================================================== -->
  {/* Labelled by the form's own visible heading (RequestForm renders it with
      id="apply-heading"), so the page has one heading for the form, not two. */}
  <section class="shell pb-section" id="apply" aria-labelledby="apply-heading">
    <Reveal class="mx-auto max-w-3xl">
      <RequestForm
        subject={d.title}
        title={d.formTitle}
        lead={d.formLead}
        fields={d.formFields}
      />
    </Reveal>
  </section>

  <!-- ===== Next offering ================================================= -->
  <CtaBand eyebrow="Not the right fit?" href={`/request-for-ai/${next.id}`} label={next.data.title}>
    {next.data.summary}
  </CtaBand>
</BaseLayout>
