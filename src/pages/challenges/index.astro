---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import RuledList from '../../components/RuledList.astro';
import RuledRow from '../../components/RuledRow.astro';
import CtaBand from '../../components/CtaBand.astro';
import { isIllustrative, rowIndex, rowMeta } from '../../lib/challenges';

const all = (await getCollection('challenges', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const sectors = [...new Set(all.map((c) => c.data.sector))].sort();

// While any entry is illustrative, the page must not claim these were engagements.
const anyIllustrative = all.some((c) => isIllustrative(c.data));
---

<BaseLayout
  title="Challenges"
  description={anyIllustrative
    ? 'Illustrative enterprise AI challenges: the kind of problem Cronos AI Lab takes on, what it would build, and what it would measure.'
    : 'Enterprise AI challenges brought to Cronos AI Lab — the problem, what we built, and what it measurably changed.'}
>
  <section class="shell pt-20 pb-16 md:pt-28 md:pb-20">
    <Reveal class="max-w-3xl">
      <p class="eyebrow">
        Customer challenges &middot; {all.length} {anyIllustrative ? 'illustrative examples' : 'engagements'}
      </p>
      <h1 class="mt-6 text-h1">
        {anyIllustrative ? 'The kinds of problems we take on.' : 'Problems we were asked to solve.'}
      </h1>
      <p class="mt-7 text-lead text-muted">
        Every engagement runs 90 days from intake to a measured verdict, and
        starts from a costly, specific problem &mdash; not an AI strategy.
      </p>
      <p class="mt-8 text-[0.9375rem] text-muted">
        <span class="eyebrow">Sectors</span>
        <span class="mt-2 block">{sectors.join(' · ')}</span>
      </p>
    </Reveal>
  </section>

  <section class="shell pb-section" aria-labelledby="challenges-list">
    <h2 id="challenges-list" class="sr-only">All challenges</h2>
    <Reveal>
      <RuledList>
        {
          all.map((challenge) => (
            <RuledRow
              index={rowIndex(challenge.data)}
              title={challenge.data.title}
              meta={rowMeta(challenge.data)}
              href={`/challenges/${challenge.id}`}
            />
          ))
        }
      </RuledList>
    </Reveal>
  </section>

  <CtaBand eyebrow="Have a problem like these?" href="/request-for-ai/challenges" label="Bring us a challenge">
    Tell us what breaks today and what it costs. We will tell you whether AI
    is the answer.
  </CtaBand>
</BaseLayout>
