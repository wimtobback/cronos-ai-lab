---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import RuledList from '../../components/RuledList.astro';
import RuledRow from '../../components/RuledRow.astro';
import { withBase } from '../../lib/url';

const all = (await getCollection('challenges', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const sectors = [...new Set(all.map((c) => c.data.sector))].sort();
---

<BaseLayout
  title="Challenges"
  description="Enterprise AI challenges brought to Cronos AI Lab — the problem, what we built, and what it measurably changed."
>
  <section class="shell pt-20 pb-16 md:pt-28 md:pb-20">
    <Reveal class="max-w-3xl">
      <p class="eyebrow">Customer challenges &middot; {all.length} engagements</p>
      <h1 class="mt-6 text-h1">Problems we were asked to solve.</h1>
      <p class="mt-7 text-lead text-muted">
        Ninety days from intake to a measured verdict. Each of these started as
        a costly, specific problem &mdash; not an AI strategy.
      </p>
      <p class="mt-8 text-[0.9375rem] text-muted">
        <span class="eyebrow">Sectors</span>
        <span class="mt-2 block">{sectors.join(' · ')}</span>
      </p>
    </Reveal>
  </section>

  <section class="shell pb-section" aria-labelledby="challenges-list">
    <h2 id="challenges-list" class="sr-only">All challenges</h2>
    <Reveal>
      <RuledList>
        {
          all.map((challenge) => (
            <RuledRow
              index={String(challenge.data.year)}
              title={challenge.data.title}
              meta={challenge.data.sector}
              href={`/challenges/${challenge.id}`}
            />
          ))
        }
      </RuledList>
    </Reveal>
  </section>

  <section class="on-ink">
    <div class="shell py-20">
      <Reveal class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Have a problem like these?</p>
          <p class="mt-4 max-w-lg text-h3">
            Tell us what breaks today. We will tell you honestly whether AI is
            the answer.
          </p>
        </div>
        <a href={withBase('/request-for-ai/challenges')} class="btn btn-primary shrink-0">
          Request for AI Challenges
        </a>
      </Reveal>
    </div>
  </section>
</BaseLayout>
